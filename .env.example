# Copy this file to .env and fill in values. NEVER commit .env.
# Only the workforce Python process reads .env. Claude Code is denied access to it.

# --- Phase 2: model providers ---
# Free key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional free-tier fallback (disabled in config/models.yaml until enabled)
GROQ_API_KEY=

# --- Privacy: turn off CrewAI anonymous telemetry ---
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
